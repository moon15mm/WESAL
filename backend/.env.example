# Local development (uvicorn on the host). Copy to backend/.env
ENV=development
SECRET_KEY=dev-insecure-secret-change-me-locally
DATABASE_URL=postgresql+psycopg://wesal_app:wesal_app@localhost:5432/wesal
DATABASE_OWNER_URL=postgresql+psycopg://wesal_owner:wesal_owner@localhost:5432/wesal
REDIS_URL=redis://localhost:6379/0
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
EMAIL_BACKEND=console
SMS_PROVIDER=console
AI_PROVIDER=local
LOG_JSON=false
# DEMO_MODE=true lets `python -m app.cli seed-demo` / `reset-demo` run (never in production)
DEMO_MODE=false
