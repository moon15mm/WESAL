# Rendered by the nginx image at start (envsubst): ${WESAL_DOMAIN}

server {
    listen 80 default_server;
    # IPv6: add "listen [::]:80 default_server;" on hosts with IPv6
    server_name _;

    location = /healthz { access_log off; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://${WESAL_DOMAIN}$request_uri; }
}

server {
    listen 443 ssl default_server;
    # IPv6: add "listen [::]:443 ssl default_server;" on hosts with IPv6
    http2 on;
    server_name ${WESAL_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${WESAL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WESAL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;
    limit_conn perip 50;

    # API docs are not published in production
    location ~ ^/api/(docs|redoc|openapi\.json) { return 404; }

    location ~ ^/api/v1/auth/(login|register|otp|forgot|reset|verify|mfa) {
        limit_req zone=auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://wesal_api;
    }

    location /api/ {
        limit_req zone=api burst=60 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://wesal_api;
    }

    location /_next/static/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://wesal_frontend;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /brand/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://wesal_frontend;
        expires 7d;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://wesal_frontend;
    }
}
