# ─────────────────────────────────────────────────────────────────────────────
# WESAL production environment (docker-compose.prod.yml). Copy to `.env`, chmod 600.
# NEVER commit the real file. Generate secrets with:  openssl rand -base64 48 | tr -d '\n'
# FIELD_ENCRYPTION_KEY:  python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ─────────────────────────────────────────────────────────────────────────────

# Public hostname (DNS A/AAAA record must point to this server)
WESAL_DOMAIN=wesal.example.com
WESAL_TAG=latest

# Database (two roles: owner for migrations, restricted app role for the running services)
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis

# Application secrets
SECRET_KEY=change-me-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=
LOG_LEVEL=INFO
API_WORKERS=2
MFA_ENFORCE_ADMIN=true
DEMO_MODE=false

# Email (required in production)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WESAL <no-reply@wesal.example.com>
SMTP_STARTTLS=true

# SMS / OTP — none | unifonic | twilio   (adapters implemented; not yet verified against live accounts)
SMS_PROVIDER=none
SMS_SENDER=WESAL
UNIFONIC_APP_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp — none | meta_cloud   (adapter implemented; untested with a live account)
WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Web push — none | webpush
PUSH_PROVIDER=none
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@wesal.example.com

# AI assistant — local (built-in, no data leaves the server) | anthropic | none
AI_ENABLED=true
AI_PROVIDER=local
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Backups (scripts/backup.sh). Encrypt to a GPG public key whose private key is kept OFF this server.
BACKUP_DIR=/var/backups/wesal
BACKUP_GPG_RECIPIENT=
BACKUP_KEEP_DAYS=14
# Off-site copy with rclone (e.g. "s3remote:wesal-backups"); leave empty to disable
BACKUP_RCLONE_REMOTE=
